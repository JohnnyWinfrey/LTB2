/* Nord: cool arctic blues */
QWidget {
    background-color: #2e3440;
    color: #d8dee9;
    font-size: 13px;
}
QGroupBox {
    border: 1px solid #4c566a;
    border-radius: 6px;
    margin-top: 10px;
    padding: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #88c0d0;
}
QPushButton {
    background-color: #3b4252;
    color: #eceff4;
    border: 1px solid #4c566a;
    border-radius: 4px;
    padding: 6px 10px;
}
QPushButton:hover   { background-color: #434c5e; }
QPushButton:pressed { background-color: #4c566a; }
QPushButton:disabled { color: #5c6373; border-color: #3b4252; }
QLineEdit {
    background-color: #272c36;
    color: #eceff4;
    border: 1px solid #4c566a;
    border-radius: 4px;
    padding: 4px;
}
QLineEdit:focus { border: 1px solid #88c0d0; }
QScrollArea { border: none; }
