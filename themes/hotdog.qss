/* Hotdog Stand: the infamous Windows 3.1 eyesore. You asked for fun. */
QWidget {
    background-color: #ff0000;
    color: #ffff00;
    font-size: 13px;
    font-weight: bold;
}
QGroupBox {
    border: 2px solid #000000;
    border-radius: 0px;
    margin-top: 10px;
    padding: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #ffff00;
}
QPushButton {
    background-color: #ffff00;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 0px;
    padding: 6px 10px;
}
QPushButton:hover   { background-color: #ffee00; }
QPushButton:pressed { background-color: #dddd00; }
QPushButton:disabled { color: #888800; background-color: #cccc00; }
QLineEdit {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 0px;
    padding: 4px;
}
QLineEdit:focus { border: 2px solid #0000ff; }
QScrollArea { border: none; }
