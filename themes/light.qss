/* Clean light theme */
QWidget {
    background-color: #f4f4f4;
    color: #1c1c1c;
    font-size: 13px;
}
QGroupBox {
    border: 1px solid #c4c4c4;
    border-radius: 6px;
    margin-top: 10px;
    padding: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #0a68b8;
}
QPushButton {
    background-color: #ffffff;
    color: #1c1c1c;
    border: 1px solid #b8b8b8;
    border-radius: 4px;
    padding: 6px 10px;
}
QPushButton:hover   { background-color: #eaeaea; }
QPushButton:pressed { background-color: #dcdcdc; }
QPushButton:disabled { color: #a0a0a0; border-color: #d0d0d0; }
QLineEdit {
    background-color: #ffffff;
    color: #1c1c1c;
    border: 1px solid #b8b8b8;
    border-radius: 4px;
    padding: 4px;
}
QLineEdit:focus { border: 1px solid #0a68b8; }
QScrollArea { border: none; }
