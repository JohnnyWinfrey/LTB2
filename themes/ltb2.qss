/* Retro terminal look, matching the old SLIM QML app (teal on dark, Courier) */
QWidget {
    background-color: #313131;
    color: #bbf6ef;
    font-family: "Courier", monospace;
    font-size: 13px;
}
QGroupBox {
    border: 2px solid #bbf6ef;
    border-radius: 5px;
    margin-top: 10px;
    padding: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #bbf6ef;
}
QPushButton {
    background-color: #676767;
    color: #bbf6ef;
    border: 2px solid #bbf6ef;
    border-radius: 3px;
    padding: 6px 10px;
}
QPushButton:hover   { background-color: #7a7a7a; }
QPushButton:pressed { background-color: #565656; }
QPushButton:disabled { color: #557777; border-color: #557777; }
QLineEdit {
    background-color: #4d4d4d;
    color: #bbf6ef;
    border: 2px solid #bbf6ef;
    border-radius: 3px;
    padding: 4px;
}
QScrollArea { border: none; }
