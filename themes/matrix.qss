/* Matrix: green phosphor on black */
QWidget {
    background-color: #000000;
    color: #00ff41;
    font-family: "Courier", monospace;
    font-size: 13px;
}
QGroupBox {
    border: 1px solid #00ff41;
    border-radius: 4px;
    margin-top: 10px;
    padding: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #00ff41;
}
QPushButton {
    background-color: #001a00;
    color: #00ff41;
    border: 1px solid #00ff41;
    border-radius: 2px;
    padding: 6px 10px;
}
QPushButton:hover   { background-color: #003300; }
QPushButton:pressed { background-color: #004d00; }
QPushButton:disabled { color: #086108; border-color: #086108; }
QLineEdit {
    background-color: #001100;
    color: #00ff41;
    border: 1px solid #008f11;
    border-radius: 2px;
    padding: 4px;
}
QLineEdit:focus { border: 1px solid #00ff41; }
QScrollArea { border: none; }
