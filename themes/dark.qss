/* Modern dark theme */
QWidget {
    background-color: #1e1e1e;
    color: #e6e6e6;
    font-size: 13px;
}
QGroupBox {
    border: 1px solid #3d3d3d;
    border-radius: 6px;
    margin-top: 10px;
    padding: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #9cdcfe;
}
QPushButton {
    background-color: #2d2d2d;
    color: #e6e6e6;
    border: 1px solid #4d4d4d;
    border-radius: 4px;
    padding: 6px 10px;
}
QPushButton:hover   { background-color: #3a3a3a; }
QPushButton:pressed { background-color: #454545; }
QPushButton:disabled { color: #6d6d6d; border-color: #333333; }
QLineEdit {
    background-color: #2a2a2a;
    color: #e6e6e6;
    border: 1px solid #4d4d4d;
    border-radius: 4px;
    padding: 4px;
}
QLineEdit:focus { border: 1px solid #007acc; }
QScrollArea { border: none; }
