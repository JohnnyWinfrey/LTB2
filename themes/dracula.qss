/* Dracula palette */
QWidget {
    background-color: #282a36;
    color: #f8f8f2;
    font-size: 13px;
}
QGroupBox {
    border: 1px solid #6272a4;
    border-radius: 6px;
    margin-top: 10px;
    padding: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #bd93f9;
}
QPushButton {
    background-color: #44475a;
    color: #f8f8f2;
    border: 1px solid #6272a4;
    border-radius: 4px;
    padding: 6px 10px;
}
QPushButton:hover   { background-color: #565971; }
QPushButton:pressed { background-color: #6272a4; }
QPushButton:disabled { color: #6272a4; border-color: #3b3d4d; }
QLineEdit {
    background-color: #21222c;
    color: #f8f8f2;
    border: 1px solid #6272a4;
    border-radius: 4px;
    padding: 4px;
}
QLineEdit:focus { border: 1px solid #ff79c6; }
QScrollArea { border: none; }
