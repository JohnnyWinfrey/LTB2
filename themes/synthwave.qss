/* Synthwave: neon pink + cyan on deep purple */
QWidget {
    background-color: #241b2f;
    color: #f0e6ff;
    font-size: 13px;
}
QGroupBox {
    border: 1px solid #ff2e97;
    border-radius: 6px;
    margin-top: 10px;
    padding: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #ff8ad8;
}
QPushButton {
    background-color: #2d2140;
    color: #00f0ff;
    border: 1px solid #ff2e97;
    border-radius: 4px;
    padding: 6px 10px;
}
QPushButton:hover   { background-color: #3a2b52; }
QPushButton:pressed { background-color: #4a3768; }
QPushButton:disabled { color: #6b5a80; border-color: #5a3a5a; }
QLineEdit {
    background-color: #1a1428;
    color: #00f0ff;
    border: 1px solid #00f0ff;
    border-radius: 4px;
    padding: 4px;
}
QLineEdit:focus { border: 1px solid #ff2e97; }
QScrollArea { border: none; }
